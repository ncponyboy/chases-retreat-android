## Copy this file to local.properties (which is NOT committed) and fill in your own values.
sdk.dir=/path/to/Android/sdk

# The Music Assistant server the Music tab connects to, and the guest account on it.
chasesretreat.server.host=192.168.x.x
chasesretreat.server.port=8095
chasesretreat.server.tls=false
chasesretreat.server.username=Guest
chasesretreat.server.password=change-me

# Lights tab: the house's Home Assistant on the LAN and its two local-only webhooks
# ("Pool Room Lights - Local webhook" and "Panel - Local mode webhook" automations).
chasesretreat.ha.url=http://192.168.x.x:8123
chasesretreat.ha.poolLightsWebhook=pool-lights-xxxx
chasesretreat.ha.panelWebhook=panel-mode-xxxx
